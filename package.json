{
  "name": "aws-cdk-ci-cd-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && npm run format:ci && npm run lint:ci",
    "cdk": "cdk",
    "deploy": "npm run cdk deploy -- --all",
    "deploy:ci": "npm run cdk deploy -- --require-approval never --asset-parallelism true --all",
    "diff": "npm run cdk diff",
    "format": "oxfmt --write .",
    "format:ci": "oxfmt --check .",
    "lint": "oxlint --fix",
    "lint:ci": "oxlint",
    "synth": "npm run cdk synth",
    "synth:silent": "npm run cdk synth -- -q",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --noEmit -w"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/lib-dynamodb": "^3.1146.0",
    "aws-cdk-lib": "2.272.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "24.19.1",
    "aws-cdk": "^2.1144.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
